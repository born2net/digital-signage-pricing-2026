  "method": "Point sizes are the values published on the DigitalSignage.com typography guide for a 1080p canvas. Minimum body text follows the line body_pt = 12 + 2.4 x viewing distance in feet (about 12 + 7.9 x metres); headline = 2 x body; fine print = body x 2/3. Physical letter heights follow the signage rule of thumb of 1 inch of letter height per 10 feet of viewing distance for comfortable reading and 1 inch per 20 feet as the minimum. PPI values are computed from the diagonal and native resolution and rounded.",
  "formulas": {
    "minimum_body_pt_from_feet": "12 + 2.4 * distance_ft",
    "minimum_body_pt_from_metres": "12 + 7.9 * distance_m",
    "headline_pt": "2 * body_pt",
    "fine_print_pt": "body_pt * 2 / 3",
    "comfortable_letter_height_in": "0.1 * distance_ft",
    "minimum_letter_height_in": "0.05 * distance_ft",
    "physical_text_height_in": "text_height_px / display_ppi"
  },
